razmer1 = 700
razmer2 = 500
window = display.set_mode((razmer1, razmer2))
display.set_caption('Maze')
background = transform.scale(image.load('background.jpg'), (razmer1, razmer2))
clock = time.Clock()
FPS = 60

#окно

mixer.init()
mixer.music.load('jungles.ogg')
mixer.music.play()
kick = mixer.Sound('kick.ogg')
money = mixer.Sound('money.ogg')
font.init()
font = font.SysFont('Arial', 70)
win = font.render('YOU WIN!', True, (255, 215, 0))
lose = font.render('YOU LOSE!!!!!!', True, (255, 0, 0))
game = True
finish = False

#музыка

gg = Player('hero.png', 2, 400, 5)
bad = Enemy('cyborg.png', 620, 280, 2)
gold = GameSprite('treasure.png', 600, 400, 60)
walls1 = Wall(0, 255, 255, 0, 350, 400, 20)
walls2 = Wall(0, 255, 255, 500, 150, 20, 500)
walls3 = Wall(0, 255, 255, 100, 250, 400, 20)
walls4 = Wall(0, 255, 255, 0, 150, 400, 20)




#спрайты


while game:
    for e in event.get():
        if e.type == QUIT:
            game = False
    if finish != True:
        window.blit(background, (0, 0))
        gg.update()
        bad.update()
        gg.reset()
        bad.reset()
        gold.reset()
        walls1.draw_wall()
        walls2.draw_wall()
        walls3.draw_wall()
        walls4.draw_wall()
        if sprite.collide_rect(gg, gold):
            finish = True
            window.blit(win, (200, 200))
            money.play()
        if sprite.collide_rect(gg, bad) or sprite.collide_rect(gg, walls1) or sprite.collide_rect(gg, walls2) or sprite.collide_rect(gg, walls3) or sprite.collide_rect(gg, walls3):
            finish = True
            window.blit(lose, (200, 200))
            kick.play()
    display.update()
    clock.tick(FPS)

